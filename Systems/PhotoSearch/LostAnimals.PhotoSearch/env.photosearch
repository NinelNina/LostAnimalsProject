RABBITMQ_URL=amqp://host.docker.internal:5672

# Storage
STORAGE_ROOT=/app/storage
UPLOAD_DIR=uploads

# Milvus
MILVUS_HOST=host.docker.internal
MILVUS_PORT=19530
MILVUS_COLLECTION=animal_embeddings

# Models
MODEL_DIR="models"

# Application settings
APP_NAME=AnimalSearch
LOG_LEVEL=DEBUG
MAX_IMAGE_SIZE=10485760

API_HOST=0.0.0.0
API_PORT=8000

MAIN_PUBLIC_URL=http://localhost:10003
MAIN_INTERNAL_URL="http://localhost:10003"
LOST_ANIMALS_API_URL=http://host.docker.internal:10000