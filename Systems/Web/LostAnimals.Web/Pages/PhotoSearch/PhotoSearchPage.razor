@page "/photosearch"
@using LostAnimals.Web.Components
@using LostAnimals.Web.Pages.Notes
@using LostAnimals.Web.Pages.Notes.Models
@using LostAnimals.Web.Pages.Notes.Services
@using LostAnimals.Web.Pages.Photo.Models
@using LostAnimals.Web.Pages.Photo.Services
@using LostAnimals.Web.Pages.PhotoSearch.Services
@inject IPhotoSearchService PhotoSearchService
@inject INoteService NoteService
@inject IPhotoService PhotoService
@inject IJSRuntime JSRuntime

<h3>Поиск по фото</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
}

@if (selectedImageData != null)
{
    <div class="image-preview">
        <MudImage Src="@selectedImageData" Alt="Selected image" Height="200" Class="mt-2 mb-2" ObjectFit="ObjectFit.Contain" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ClearSelectedImage">Загрузить другое фото</MudButton>
    </div>
}
else
{
    <div class="drop-zone" @ondragover:preventDefault>
        Перетащите фото сюда или
        <InputFile id="fileInput" @ref="fileInput" OnChange="@HandleFileSelected" Accept="image/*" hidden />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@TriggerFileInput">Выбрать фото</MudButton>
    </div>
}

@if (isLoading)
{
    <p>Загрузка...</p>
}
else if (notes != null && notes.Any())
{
    <h4>Результаты поиска:</h4>
    @foreach (var note in notes)
    {
        <NoteCard Note="note" PhotosDictionary="PhotosDictionary" />
    }
}
else if (notes != null)
{
    <p>Ничего не найдено.</p>
}

@code {
    private List<NoteViewModel>? notes;
    private bool isLoading;
    private string? errorMessage;
    private string? selectedImageData;
    private InputFile? fileInput;
    private Dictionary<Guid, IEnumerable<PhotoStorageViewModel>> PhotosDictionary { get; set; } = new(); // Initialize to avoid null

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("handleDragAndDrop.init", DotNetObjectReference.Create(this), "fileInput");
        }
    }

    private async Task TriggerFileInput()
    {
        await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('fileInput').click();");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            isLoading = true;
            try
            {
                // Convert file to base64 for display
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB limit
                using var memoryStream = new MemoryStream();
                await stream.CopyToAsync(memoryStream);
                var buffer = memoryStream.ToArray();
                selectedImageData = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}";

                // Perform search
                var searchResults = await PhotoSearchService.SearchByPhotoAsync(file);
                notes = new List<NoteViewModel>();
                PhotosDictionary.Clear(); // Clear previous photos
                foreach (var result in searchResults)
                {
                    var note = await NoteService.GetNote(Guid.Parse(result.NoteId));
                    notes.Add(note);

                    // Load photos for the note's gallery
                    if (note.PhotoGalleryId.HasValue)
                    {
                        var photos = await PhotoService.GetPhotosByGalleryId(note.PhotoGalleryId.Value);
                        PhotosDictionary[note.PhotoGalleryId.Value] = photos;
                    }
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Ошибка при поиске: {ex.Message}";
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private void ClearSelectedImage()
    {
        selectedImageData = null;
        notes = null;
        PhotosDictionary.Clear(); // Clear photos when resetting
        StateHasChanged();
    }
}